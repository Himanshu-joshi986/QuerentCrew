# ---------- LLM (pick ONE provider) ----------
# Format is "provider:model" (LangChain init_chat_model). Free options:
#   Groq   : groq:openai/gpt-oss-120b             -> GROQ_API_KEY  (https://console.groq.com)
#   Gemini : google_genai:gemini-2.5-flash        -> GOOGLE_API_KEY (https://aistudio.google.com)
#   Local  : ollama:llama3.1                       -> no key, needs Ollama running
#   OpenAI : openai:gpt-4o-mini                    -> OPENAI_API_KEY
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Optional second model used automatically if the first one fails
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0

# ---------- LangSmith tracing (optional, free tier) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querentcrew

# ---------- Data ----------
DATABASE_PATH=data/sales.db
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=10

# ---------- Agent behaviour ----------
MAX_SQL_RETRIES=2
MAX_SUB_QUESTIONS=3
PROMPT_VERSION_SQL=v3

# ---------- Governance ----------
PII_COLUMNS=email,phone
REQUIRE_APPROVAL_FOR_PII=true
REQUIRE_APPROVAL_FOR_ALL=false
